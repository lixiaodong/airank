# 复制成 .deploy.env 后填入真实值。.deploy.env 已被 .gitignore 排除，不会进公开仓库。
LARK_APP_ID="cli_xxxxxxxxxxxxxxxx"                        # Lark 国际版应用 App ID（brand=lark）
LARK_OPEN_ID="ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"        # 线索私聊接收人 open_id
BASE_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxx"                  # 多维表格 base_token
TABLE_ID="tblxxxxxxxxxxxx"                                # 多维表格 table_id
BASE_LINK="https://<tenant>.larksuite.com/base/<base_token>"   # 卡片按钮跳转地址
